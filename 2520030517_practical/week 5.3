#include <stdio.h>
#include <unistd.h>
#include <fcntl.h>
#include <string.h>
#include <sys/stat.h>

int main()
{
    mkfifo("/tmp/receiving_fifo", 0666);

    char msg[] = "Hello Receiver";

    int fd = open("/tmp/receiving_fifo", O_WRONLY);

    write(fd, msg, strlen(msg));

    close(fd);

    return 0;
}
