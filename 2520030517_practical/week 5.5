#include <stdio.h>

int main()
{
    int choice;

    while (1)
    {
        printf("\nCPU Scheduling Algorithms\n");
        printf("1. FCFS\n");
        printf("2. SJF\n");
        printf("3. SRTF\n");
        printf("4. Priority Non-Preemptive\n");
        printf("5. Priority Preemptive\n");
        printf("6. Round Robin\n");
        printf("7. Multilevel Queue\n");
        printf("8. Exit\n");

        printf("Select one of the CPU scheduling Algorithms: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                printf("Operations of FCFS\n");
                break;

            case 2:
                printf("Operations of SJF\n");
                break;

            case 3:
                printf("Operations of SRTF\n");
                break;

            case 4:
                printf("Operations of Priority Non-Preemptive\n");
                break;

            case 5:
                printf("Operations of Priority Preemptive\n");
                break;

            case 6:
                printf("Operations of Round Robin\n");
                break;

            case 7:
                printf("Operations of Multilevel Queue\n");
                break;

            case 8:
                printf("Exiting...\n");
                return 0;

            default:
                printf("Invalid choice! Please select 1 to 8.\n");
        }
    }

    return 0;
}
